# Dockerfile pour un déploiement sur serveur avec GPU NVIDIA
# (location cloud à l'heure : RunPod, Vast.ai, AWS EC2 g4dn/g5, GCP, etc.)
#
# Nécessite sur la machine hôte :
#   - un GPU NVIDIA récent (T4, A10, RTX 30/40xx...)
#   - le driver NVIDIA installé
#   - nvidia-container-toolkit installé (pour que Docker voie le GPU)
#
# Build :
#   docker build -f Dockerfile.gpu -t cine-translate-backend-gpu .
#
# Run (le --gpus all est indispensable, sinon le conteneur ne voit pas la carte) :
#   docker run --gpus all -p 8000:8000 --env-file .env cine-translate-backend-gpu

FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.11 python3-pip ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip3 install --no-cache-dir -r requirements.txt

COPY app ./app

# A definir dans .env pour ce build :
#   WHISPER_DEVICE=cuda
#   WHISPER_COMPUTE_TYPE=float16
#   WHISPER_MODEL_SIZE=medium (ou large-v3, le GPU encaisse bien plus facilement)

EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
